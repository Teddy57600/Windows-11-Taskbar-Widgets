<UserControl x:Class="TaskbarWidgets.Views.MetricView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- Vue standard : barre de niveau verticale + libellé coloré + valeur. DataContext = TaskbarWidget. -->
    <Grid Margin="8,0,10,0" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Width="4" Height="28" VerticalAlignment="Center">
            <Border CornerRadius="2" Background="{DynamicResource BarTrackBrush}" />
            <Border CornerRadius="2" Background="{Binding AccentBrush}" RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="{Binding Level, TargetNullValue=0, FallbackValue=0}" />
                </Border.RenderTransform>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" MinWidth="{Binding MinValueWidth}">
            <TextBlock Text="{Binding Label}" Foreground="{Binding AccentBrush}" FontSize="10.5" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource ValueBrush}" FontSize="12.5" FontWeight="Bold" Margin="0,-2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
