<Window x:Class="TaskbarWidgets.TaskbarHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Widgets"
        Icon="Assets/TaskbarWidgets.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="1" Height="48"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="ValueBrush" Color="White" />
        <SolidColorBrush x:Key="BarTrackBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF" />
    </Window.Resources>

    <!-- Fond quasi transparent : indispensable pour recevoir les clics et le survol. -->
    <!-- Le Canvas mesure le panneau sans contrainte : sa DesiredSize donne la largeur réelle des widgets
         sans forcer de remise en page à chaque tic du minuteur. -->
    <Border x:Name="Root" Background="#01000000">
        <Canvas>
            <StackPanel x:Name="WidgetsPanel" Orientation="Horizontal" />
        </Canvas>
    </Border>
</Window>
